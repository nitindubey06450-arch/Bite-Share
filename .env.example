PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/biteshare?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Demo Mode: returns OTP in response & prints to console
DEMO_MODE=true

# OpenAI API Key (gpt-4o-mini for Food Nutrition & Shelf-life Analysis)
OPENAI_API_KEY=your_openai_api_key_here

# AI Search (Google Gemini API Key)
AI_API_KEY=your_gemini_api_key_here

# Google Maps Live API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Frontend Client URL / Origin (for CORS)
CLIENT_URL=http://localhost:5000
FRONTEND_ORIGIN=http://localhost:5000
