<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Customer Login | BiteShare</title>
  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="customer-login.css">
</head>
<body class="login-page">

  <div class="card login-modal">
    <a href="index.html" class="close-btn">&times;</a>
    <div class="center-text">
      <span class="badge orange-outline-badge">RECIPIENT • FOOD FINDER</span>
      <h2>Customer Login</h2>
      <p class="subtitle">Sign in to claim fresh meals and track your orders.</p>
    </div>

    <form class="login-form">
      <div class="form-group">
        <label>Email or Phone Number *</label>
        <input type="text" placeholder="name@example.com or +91 98765..." required>
      </div>

      <div class="form-group">
        <label>Password *</label>
        <input type="password" placeholder="••••••••" required>
      </div>

      <div class="form-options">
        <label><input type="checkbox"> Remember me</label>
        <a href="#" class="link-orange">Forgot password?</a>
      </div>

      <button type="submit" class="btn btn-orange btn-full">Sign In as Customer</button>
    </form>

    <p class="footer-text">Don't have an account? <a href="#" class="link-orange">Sign Up Here</a></p>
  </div>

</body>
</html>