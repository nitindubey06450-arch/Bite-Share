<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Community Login | BiteShare</title>
  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="community-login.css">
</head>
<body class="login-page">

  <div class="card login-modal community-border">
    <a href="index.html" class="close-btn">&times;</a>
    <div class="center-text">
      <span class="badge green-badge">VOLUNTEER • VERIFIED NGO</span>
      <h2>Community Login</h2>
      <p class="subtitle">Log in to coordinate food relief and manage bulk meal pickups.</p>
    </div>

    <form class="login-form">
      <div class="form-group">
        <label>Organization or Volunteer Email *</label>
        <input type="email" placeholder="volunteer@ngo.org" required>
      </div>

      <div class="form-group">
        <label>Password *</label>
        <input type="password" placeholder="••••••••" required>
      </div>

      <div class="form-options">
        <label><input type="checkbox"> Keep me logged in</label>
        <a href="#" class="link-green">Need assistance?</a>
      </div>

      <button type="submit" class="btn btn-green btn-full">Sign In to Community Portal</button>
    </form>

    <p class="footer-text">Want to register an NGO or volunteer? <a href="#" class="link-green">Register Here</a></p>
  </div>

</body>
</html>